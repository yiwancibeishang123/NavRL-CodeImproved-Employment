<launch>
  <arg name="real" default="false" />
  <arg name="use_px4" default="false" />
  <arg name="use_safety_shield" default="true" />
  <arg name="use_real_detector" default="false" />
  <arg name="rviz" default="true" />
  <arg name="model_checkpoint" default="$(find navigation_runner)/scripts/ckpts/step3-80new.pt" />
  <arg name="device" default="cuda:0" />
  <arg name="auto_takeoff" default="false" />
  <arg name="require_safety_shield" default="false" />
  <arg name="run_label" default="unlabeled" />
  <arg name="metrics_log" default="" />
  <arg name="observation_trace_log" default="" />
  <arg name="metrics_resource_stride" default="20" />
  <arg name="sim_real_perturbation_enabled" default="false" />
  <arg name="sim_real_perturbation_seed" default="7" />
  <arg name="lidar_noise_std" default="0.0" />
  <arg name="lidar_dropout_ratio" default="0.0" />
  <arg name="obstacle_position_noise_std" default="0.0" />
  <arg name="obstacle_velocity_noise_std" default="0.0" />
  <arg name="obstacle_dropout_ratio" default="0.0" />
  <arg name="state_noise_std" default="0.0" />
  <arg name="observation_delay_steps" default="0" />
  <arg name="timing_degrade_enabled" default="true" />
  <arg name="timing_degrade_consecutive_cycles" default="2" />
  <arg name="timing_degrade_max_lag_ms" default="20.0" />
  <arg name="timing_degrade_hold_s" default="0.5" />
  <arg name="sensor_timeout" default="0.5" />
  <arg name="obstacle_timeout" default="0.5" />
  <arg name="cruise_speed_mps" default="0.0" />
  <arg name="perception_watchdog_enabled" default="true" />
  <arg name="perception_watchdog_required" default="false" />
  <arg name="perception_timeout" default="0.5" />
  <arg name="perception_require_detection" default="false" />
  <arg name="perception_lidar_fallback_enabled" default="true" />
  <arg name="perception_lidar_escape_distance_m" default="1.4" />
  <arg name="perception_lidar_escape_speed_mps" default="0.45" />
  <arg name="mission_goal_tolerance_m" default="1.0" />
  <arg name="hold_height" default="1.0" />
  <arg name="height_control" default="false" />
  <arg name="color_topic" default="/camera/color/image_raw" />
  <arg name="policy_variant" default="improved_navrl" />
  <arg name="policy_always_on" default="true" />
  <arg name="deployment_guidance_enabled" default="true" />
  <arg name="policy_residual_weight" default="0.35" />
  <arg name="goal_guidance_speed_mps" default="0.8" />
  <arg name="lidar_avoidance_distance_m" default="1.4" />

  <include if="$(arg real)" file="$(find navigation_runner)/launch/safety_and_perception_real.launch">
    <arg name="use_safety_shield" value="$(arg use_safety_shield)" />
    <arg name="rviz" value="$(arg rviz)" />
    <arg name="model_checkpoint" value="$(arg model_checkpoint)" />
    <arg name="device" value="$(arg device)" />
    <arg name="auto_takeoff" value="$(arg auto_takeoff)" />
    <arg name="require_safety_shield" value="$(arg require_safety_shield)" />
    <arg name="run_label" value="$(arg run_label)" />
    <arg name="metrics_log" value="$(arg metrics_log)" />
    <arg name="observation_trace_log" value="$(arg observation_trace_log)" />
    <arg name="metrics_resource_stride" value="$(arg metrics_resource_stride)" />
    <arg name="sim_real_perturbation_enabled" value="$(arg sim_real_perturbation_enabled)" />
    <arg name="sim_real_perturbation_seed" value="$(arg sim_real_perturbation_seed)" />
    <arg name="lidar_noise_std" value="$(arg lidar_noise_std)" />
    <arg name="lidar_dropout_ratio" value="$(arg lidar_dropout_ratio)" />
    <arg name="obstacle_position_noise_std" value="$(arg obstacle_position_noise_std)" />
    <arg name="obstacle_velocity_noise_std" value="$(arg obstacle_velocity_noise_std)" />
    <arg name="obstacle_dropout_ratio" value="$(arg obstacle_dropout_ratio)" />
    <arg name="state_noise_std" value="$(arg state_noise_std)" />
    <arg name="observation_delay_steps" value="$(arg observation_delay_steps)" />
    <arg name="timing_degrade_enabled" value="$(arg timing_degrade_enabled)" />
    <arg name="timing_degrade_consecutive_cycles" value="$(arg timing_degrade_consecutive_cycles)" />
    <arg name="timing_degrade_max_lag_ms" value="$(arg timing_degrade_max_lag_ms)" />
    <arg name="timing_degrade_hold_s" value="$(arg timing_degrade_hold_s)" />
    <arg name="sensor_timeout" value="$(arg sensor_timeout)" />
    <arg name="obstacle_timeout" value="$(arg obstacle_timeout)" />
    <arg name="cruise_speed_mps" value="$(arg cruise_speed_mps)" />
    <arg name="perception_watchdog_enabled" value="$(arg perception_watchdog_enabled)" />
    <arg name="perception_watchdog_required" value="$(arg perception_watchdog_required)" />
    <arg name="perception_timeout" value="$(arg perception_timeout)" />
    <arg name="perception_require_detection" value="$(arg perception_require_detection)" />
    <arg name="perception_lidar_fallback_enabled" value="$(arg perception_lidar_fallback_enabled)" />
    <arg name="perception_lidar_escape_distance_m" value="$(arg perception_lidar_escape_distance_m)" />
    <arg name="perception_lidar_escape_speed_mps" value="$(arg perception_lidar_escape_speed_mps)" />
    <arg name="mission_goal_tolerance_m" value="$(arg mission_goal_tolerance_m)" />
    <arg name="hold_height" value="$(arg hold_height)" />
    <arg name="height_control" value="$(arg height_control)" />
    <arg name="color_topic" value="$(arg color_topic)" />
    <arg name="policy_variant" value="$(arg policy_variant)" />
    <arg name="policy_always_on" value="$(arg policy_always_on)" />
    <arg name="deployment_guidance_enabled" value="$(arg deployment_guidance_enabled)" />
    <arg name="policy_residual_weight" value="$(arg policy_residual_weight)" />
    <arg name="goal_guidance_speed_mps" value="$(arg goal_guidance_speed_mps)" />
    <arg name="lidar_avoidance_distance_m" value="$(arg lidar_avoidance_distance_m)" />
  </include>
  <include unless="$(arg real)" file="$(find navigation_runner)/launch/safety_and_perception_sim.launch">
    <arg name="use_px4" value="$(arg use_px4)" />
    <arg name="use_safety_shield" value="$(arg use_safety_shield)" />
    <arg name="use_real_detector" value="$(arg use_real_detector)" />
    <arg name="rviz" value="$(arg rviz)" />
    <arg name="model_checkpoint" value="$(arg model_checkpoint)" />
    <arg name="device" value="$(arg device)" />
    <arg name="auto_takeoff" value="$(arg auto_takeoff)" />
    <arg name="require_safety_shield" value="$(arg require_safety_shield)" />
    <arg name="run_label" value="$(arg run_label)" />
    <arg name="metrics_log" value="$(arg metrics_log)" />
    <arg name="observation_trace_log" value="$(arg observation_trace_log)" />
    <arg name="metrics_resource_stride" value="$(arg metrics_resource_stride)" />
    <arg name="sim_real_perturbation_enabled" value="$(arg sim_real_perturbation_enabled)" />
    <arg name="sim_real_perturbation_seed" value="$(arg sim_real_perturbation_seed)" />
    <arg name="lidar_noise_std" value="$(arg lidar_noise_std)" />
    <arg name="lidar_dropout_ratio" value="$(arg lidar_dropout_ratio)" />
    <arg name="obstacle_position_noise_std" value="$(arg obstacle_position_noise_std)" />
    <arg name="obstacle_velocity_noise_std" value="$(arg obstacle_velocity_noise_std)" />
    <arg name="obstacle_dropout_ratio" value="$(arg obstacle_dropout_ratio)" />
    <arg name="state_noise_std" value="$(arg state_noise_std)" />
    <arg name="observation_delay_steps" value="$(arg observation_delay_steps)" />
    <arg name="timing_degrade_enabled" value="$(arg timing_degrade_enabled)" />
    <arg name="timing_degrade_consecutive_cycles" value="$(arg timing_degrade_consecutive_cycles)" />
    <arg name="timing_degrade_max_lag_ms" value="$(arg timing_degrade_max_lag_ms)" />
    <arg name="timing_degrade_hold_s" value="$(arg timing_degrade_hold_s)" />
    <arg name="sensor_timeout" value="$(arg sensor_timeout)" />
    <arg name="obstacle_timeout" value="$(arg obstacle_timeout)" />
    <arg name="cruise_speed_mps" value="$(arg cruise_speed_mps)" />
    <arg name="perception_watchdog_enabled" value="$(arg perception_watchdog_enabled)" />
    <arg name="perception_watchdog_required" value="$(arg perception_watchdog_required)" />
    <arg name="perception_timeout" value="$(arg perception_timeout)" />
    <arg name="perception_require_detection" value="$(arg perception_require_detection)" />
    <arg name="perception_lidar_fallback_enabled" value="$(arg perception_lidar_fallback_enabled)" />
    <arg name="perception_lidar_escape_distance_m" value="$(arg perception_lidar_escape_distance_m)" />
    <arg name="perception_lidar_escape_speed_mps" value="$(arg perception_lidar_escape_speed_mps)" />
    <arg name="mission_goal_tolerance_m" value="$(arg mission_goal_tolerance_m)" />
    <arg name="hold_height" value="$(arg hold_height)" />
    <arg name="height_control" value="$(arg height_control)" />
    <arg name="color_topic" value="$(arg color_topic)" />
    <arg name="policy_variant" value="$(arg policy_variant)" />
    <arg name="policy_always_on" value="$(arg policy_always_on)" />
    <arg name="deployment_guidance_enabled" value="$(arg deployment_guidance_enabled)" />
    <arg name="policy_residual_weight" value="$(arg policy_residual_weight)" />
    <arg name="goal_guidance_speed_mps" value="$(arg goal_guidance_speed_mps)" />
    <arg name="lidar_avoidance_distance_m" value="$(arg lidar_avoidance_distance_m)" />
  </include>
</launch>
