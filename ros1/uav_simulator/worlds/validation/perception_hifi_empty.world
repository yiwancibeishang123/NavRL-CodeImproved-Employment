<?xml version='1.0'?>
<sdf version='1.6'>
  <!-- Negative control: the same camera sees no person target. -->
  <world name='perception_hifi_empty'>
    <physics name='ode' type='ode'>
      <max_step_size>0.001</max_step_size>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
    <include><uri>model://ground_plane</uri></include>
    <include><uri>model://sun</uri></include>
    <scene>
      <ambient>0.45 0.45 0.45 1</ambient>
      <background>0.55 0.65 0.75 1</background>
      <shadows>true</shadows>
    </scene>
    <model name='background_wall'>
      <static>true</static>
      <pose>5.5 0 1.5 0 0 0</pose>
      <link name='link'>
        <collision name='collision'><geometry><box><size>0.2 8 3</size></box></geometry></collision>
        <visual name='visual'>
          <geometry><box><size>0.2 8 3</size></box></geometry>
          <material><ambient>0.65 0.65 0.65 1</ambient><diffuse>0.65 0.65 0.65 1</diffuse></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
